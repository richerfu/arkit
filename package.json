{
  "name": "arkit-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run format:check && pnpm run lint && pnpm run website:typecheck",
    "format": "oxfmt website package.json pnpm-workspace.yaml prek.toml .github/workflows/website.yml .oxfmtrc.json .oxlintrc.json",
    "format:check": "oxfmt --check website package.json pnpm-workspace.yaml prek.toml .github/workflows/website.yml .oxfmtrc.json .oxlintrc.json",
    "lint": "oxlint website",
    "lint:fix": "oxlint --fix website",
    "prek:check": "prek run --all-files",
    "prek:install": "prek install",
    "website:build": "pnpm --filter arkit-website run build",
    "website:dev": "pnpm --filter arkit-website run dev",
    "website:preview": "pnpm --filter arkit-website run preview",
    "website:typecheck": "pnpm --filter arkit-website run check"
  },
  "devDependencies": {
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0"
  },
  "packageManager": "pnpm@10.24.0"
}
