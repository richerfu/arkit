---
import { cn } from "@/lib/cn";

interface Props {
  class?: string;
  href?: string;
}

const { class: className, href } = Astro.props;
const classes = cn(
  "rounded-xl border border-border bg-card text-card-foreground shadow-xs transition-colors",
  href && "hover:bg-accent/30",
  className,
);
---

{
  href ? (
    <a class={classes} href={href}>
      <slot />
    </a>
  ) : (
    <div class={classes}>
      <slot />
    </div>
  )
}
