{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "plugins": ["import", "typescript", "unicorn"],
  "ignorePatterns": [
    "**/.astro/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/target/**",
    "app/**",
    "crates/**",
    "examples/**",
    "website/src/env.d.ts"
  ],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      "files": ["website/src/**/*.{ts,js,mjs,astro}"],
      "env": {
        "browser": true
      },
      "rules": {
        "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }]
      }
    },
    {
      "files": ["website/astro.config.mjs", "website/**/*.config.*"],
      "env": {
        "node": true
      }
    }
  ]
}
